# Área metropolitana y familia de categorías del equipo (reportadas al docente; no se repiten).
# Este archivo SÍ va al repositorio: no tiene secretos y Jenkins lo necesita.
#
# Estados de Yelp por área: PA (Philadelphia), FL (Tampa), IN (Indianapolis), TN (Nashville),
# AZ (Tucson), LA (New Orleans), NV (Reno), AB (Edmonton), MO,IL (Saint Louis),
# CA (Santa Barbara), ID (Boise). Varios separados por coma, por ejemplo PA,NJ,DE.
LIFEMAP_ESTADOS=FL
# Categoría "familia" tal como aparece en Yelp: Restaurants, Shopping, Nightlife, Beauty & Spas...
LIFEMAP_CATEGORIA=Restaurants
# Opcional: recorte lat_min,lat_max,lon_min,lon_max (vacío = todo el estado)
LIFEMAP_CAJA=
