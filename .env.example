# Copiar a .env para desarrollo local:  cp .env.example .env
# .env está en .gitignore. Nunca subir valores reales.
# En Jenkins, Mongo y Kaggle NO se leen de aquí: vienen de las credenciales
# "mongo-root" y "kaggle-api-token". USAR LOS MISMOS VALORES en ambos lados, porque
# comparten el volumen de MongoDB (la contraseña queda fijada al crear el volumen).

# --- MongoDB ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=cambiar_esto
MONGO_DB=lifemap

# --- Kaggle (Settings -> API -> Generate New Token) ---
KAGGLE_API_TOKEN=
KAGGLE_DATASET=yelp-dataset/yelp-dataset

# El área y la familia de categorías están en config/area.env (versionado).

# --- Ingesta ---
# 0 = procesar todo review.json; >0 = solo las primeras N particiones (pruebas rápidas)
INGEST_MAX_PARTICIONES=0
INGEST_BATCH_SIZE=5000
REVIEW_BLOCKSIZE=32MB
FORCE_RELOAD=false

# --- URL pública ---
# ngrok: crear cuenta gratis, copiar el authtoken y el dominio estático (Domains)
NGROK_AUTHTOKEN=
NGROK_URL=https://tu-dominio.ngrok-free.app

# --- Webhook: canal creado en https://smee.io ---
SMEE_URL=

# --- API ---
API_PORT=5000

# --- Recursos (la suma de límites es ~14 GB; con 8 GB bajar los *_MEM y SPARK_WORKER_MEMORY) ---
MONGO_MEM=2g
SPARK_MASTER_MEM=1536m
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CONTAINER_MEM=2560m
SPARK_EXECUTOR_MEMORY=1200m
DASK_SCHEDULER_MEM=1g
DASK_WORKER_THREADS=2
DASK_WORKER_MEMORY=1.5GiB
DASK_WORKER_CONTAINER_MEM=2g
API_MEM=1536m
JENKINS_MEM=2g

# --- Entrega 2 ---
# Mantener el mismo corte en sentimiento, riesgo, productor y consumidor.
FECHA_CORTE=2019-01-01
CORTE_ENTRENAMIENTO=2018-01-01
STREAMING_ENABLED=false
STREAMING_MEM=2g
HOTSPOT_UMBRAL_PP=15
HOTSPOT_MIN_RESENAS=20
